generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  price      Int
  imageUrl   String
  stock      Int
  version    Int         @default(0)
  orderItems OrderItem[]
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Promotion {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  discountPercent Int
  expiresAt       DateTime
  active          Boolean  @default(true)
  orders          Order[]
}

model Order {
  id          Int                 @id @default(autoincrement())
  userId      Int
  user        User                @relation(fields: [userId], references: [id])
  status      OrderStatus         @default(PENDING)
  subtotal    Int
  discount    Int                 @default(0)
  total       Int
  promotionId Int?
  promotion   Promotion?          @relation(fields: [promotionId], references: [id])
  createdAt   DateTime            @default(now())
  items       OrderItem[]
  payments    Payment[]
  loyalty     LoyaltyTransaction?
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  size      String
  toppings  String[]
  qty       Int
  lineTotal Int
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique
  amount         Int
  method         PaymentMethod
  status         PaymentStatus
  createdAt      DateTime      @default(now())
}

// orderId là duy nhất: mỗi đơn chỉ được cộng điểm một lần
model LoyaltyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  points    Int
  createdAt DateTime @default(now())
}
