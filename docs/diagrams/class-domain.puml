@startuml class-domain
title Class diagram: mô hình miền BrewLite

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

class User {
  id : int
  email : string {unique}
  passwordHash : string
  loyaltyPoints : int
}

class Product {
  id : int
  name : string
  price : int
  imageUrl : string
  stock : int
  version : int
}

class Order {
  id : int
  status : OrderStatus
  subtotal : int
  discount : int
  total : int
  createdAt : datetime
}

class OrderItem {
  id : int
  size : string
  toppings : string[]
  qty : int
  lineTotal : int
}

note right of OrderItem
  lineTotal = (giá món + phụ thu size + phụ thu topping) x qty.
  Bảng phụ thu S/M/L và topping cố định trong mã nguồn (pricing.ts);
  server tự tính, không tin giá từ trình duyệt.
end note

class Payment {
  id : int
  idempotencyKey : string {unique}
  amount : int
  method : PaymentMethod
  status : PaymentStatus
  createdAt : datetime
}

class Promotion {
  id : int
  code : string {unique}
  discountPercent : int
  expiresAt : datetime
  active : boolean
}

class LoyaltyTransaction {
  id : int
  points : int
  createdAt : datetime
}

User "1" -- "0..*" Order : đặt
Order "1" *-- "1..*" OrderItem : gồm
Product "1" -- "0..*" OrderItem : được đặt trong
Order "1" -- "0..*" Payment : được thanh toán bởi
Promotion "0..1" -- "0..*" Order : áp dụng cho
User "1" -- "0..*" LoyaltyTransaction : tích điểm
Order "1" -- "0..1" LoyaltyTransaction : sinh ra

Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
@enduml
